# .env.example — Template for local development
# Copy to .env and fill in your values.

# Database (must match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://sushruta:sushruta_dev_password@localhost:5432/sushruta

# JWT Authentication
SECRET_KEY=your-long-random-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI (Phase 2+)
OPENAI_API_KEY=sk-your-openai-key-here

# Application
APP_NAME=Sushruta
DEBUG=True
ENVIRONMENT=development

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10